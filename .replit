modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_QoelNRBOqonCv7"
WHOP_PLAN_ID_TRAIN_4B = "plan_bKayaEfpqhaGh"
WHOP_PLAN_ID_TRAIN_70B = "plan_babQrydeHmjL2"
WHOP_PLAN_ID_TRAIN_9B = "plan_ypH897CX8rMuv"
WHOP_PLAN_ID_USAGE_10K = "plan_A8MwCykfBekJe"
WHOP_PLAN_ID_MODEL_CHAT = "plan_1NPT6GSjTNrlO"

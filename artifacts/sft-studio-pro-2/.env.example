# The DigitalOcean inference credential belongs in the API Server environment,
# not the browser-facing web app.
API_KEY="MY_API_KEY"

# APP_URL: Public URL used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional. Required only if you decide to accept live payments via Stripe.
STRIPE_SECRET_KEY=

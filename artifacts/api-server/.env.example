# DigitalOcean Inference (server-side; configure the credential in Replit Secrets)
DIGITALOCEAN_TOKEN=
# GRADIENT_MODEL_ACCESS_KEY is also accepted as a credential alias.
API_KEY="MY_API_KEY"
DO_MODEL="glm-5.3-flash"
DO_VISION_MODEL="nemotron-nano-12b-v2-vl"
DO_GENERATION_MODELS="glm-5.3-flash,mistral-3-14B,deepseek-4-flash,qwen3.8-max,llama-4-maverick"

# APP_URL: Public URL used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional. Required only if you decide to accept live payments via Stripe.
STRIPE_SECRET_KEY=
